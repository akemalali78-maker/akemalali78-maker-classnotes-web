# 复制为 .env（或在部署平台的环境变量里设置），不要提交真实 Key
# 阿里云百炼 API Key（转写 + 纪要都用它）
DASHSCOPE_API_KEY=<redacted>
# 纪要生成模型（默认 qwen-plus，可改为 qwen-max / qwen-turbo 等）
QWEN_MODEL=qwen-plus
# 语音转写模型（默认 qwen-audio-3.0-asr-flash；注意 qwen3-asr-flash 未必在你的工作空间授权列表里）
ASR_MODEL=qwen-audio-3.0-asr-flash
# 问答检测/作答用便宜模型（默认 qwen-flash）
QWEN_DETECT_MODEL=qwen-flash
# 课表截图识别用视觉模型（默认 qwen3-vl-plus）
QWEN_VL_MODEL=qwen3-vl-plus
# 公网访问地址（转写服务需要通过公网 URL 拉取音频，必填，如 https://xxx.sealos.run，末尾不带斜杠）
PUBLIC_BASE_URL=https://your-domain.example.com
# 公网试用建议设置随机邀请码，避免陌生人注册后消耗 AI 额度；不影响已有密码。
REGISTRATION_CODE=
# 仅本地联调测试用：1 = 用假数据代替真实 AI 调用（上线必须关掉/不设置）
# MOCK_AI=1
