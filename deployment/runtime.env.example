# 只在服务器私密文件 /etc/classnotes.env 或本地私密文件填写，不能进入 Git。
DASHSCOPE_API_KEY=
PUBLIC_BASE_URL=https://shynarbuy.com
ASR_MODEL=qwen-audio-3.0-asr-flash
QWEN_MODEL=qwen-plus
QWEN_DETECT_MODEL=qwen-flash
QWEN_VL_MODEL=qwen3-vl-plus
# 部署时设置随机邀请码，注册界面需要填写；已有密码不变。
REGISTRATION_CODE=
# 上线不设置 MOCK_AI，也不设置 KEEP_AUDIO。
